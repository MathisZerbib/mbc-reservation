# Database Configuration
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL="postgresql://zer:password@localhost:5432/restaurant_db"
# Optional direct connection used by Prisma migrations (recommended for Neon pooler setups)
# Keep DATABASE_URL on pooler for app traffic, and DIRECT_DATABASE_URL on direct host for migrate/ddl.
DIRECT_DATABASE_URL="postgresql://zer:password@localhost:5432/restaurant_db"

# JWT Secrets
# Generate secure random strings for production:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="your-super-secret-access-token-key-change-this-in-production"

# Seed / demo accounts (optional)
# Seed creates the admin user only when both are set — never hardcoded.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-before-any-deploy"
# Email of the shared demo account used by POST /auth/demo (created on demand).
DEMO_EMAIL="demo@example.com"

# Email Service Configuration
# Get your API key from https://resend.com
RESEND_API_KEY="re_your_resend_api_key_here"
FROM_EMAIL="noreply@yourdomain.com"

# Cloudflare Turnstile (bot protection on register + public booking)
# Dashboard: https://dash.cloudflare.com/?to=/:account/turnstile
# Canonical name is TURNSTILE_SECRET; TURNSTILE_SECRET_KEY is also accepted.
# Without either, server-side verification is bypassed (local dev only).
TURNSTILE_SECRET=""
# Comma-separated frontend hostnames enforced on siteverify (production value).
# Localhost entries must never appear here — dev bypasses via missing secret.
TURNSTILE_HOSTNAMES="mbc-reservation.vercel.app"

# Server Configuration
PORT=3000
NODE_ENV=development

# Frontend URL
# Used for CORS and email links
FRONTEND_URL="http://localhost:5173"

# Floor-plan image storage (Cloudinary — required in production)
# Render's disk is ephemeral, so uploads must go to Cloudinary.
# Preferred: single URL. Set it in Render → Environment, never commit the secret.
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL="cloudinary://123456789012345:your-api-secret-here@your-cloud-name"
# Alternative split vars (either CLOUDINARY_URL or all three below):
# CLOUDINARY_CLOUD_NAME="your-cloud-name"
# CLOUDINARY_API_KEY="123456789012345"
# CLOUDINARY_API_SECRET="your-api-secret-here"
