generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                 String    @id @default(uuid())
  name               String
  slug               String    @unique
  trialEndsAt        DateTime
  onboardingComplete Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  users              User[]
  bookings           Booking[]
  tables             Table[]
  settings           RestaurantSettings?
}

enum Role {
  OWNER
  STAFF
}

model User {
  id            String         @id @unique @default(uuid())
  email         String         @unique
  password      String
  emailVerified DateTime?
  role          Role           @default(OWNER)
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id          String   @id @unique @default(uuid())
  hashedToken String   @unique
  userId      String
  revoked     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  expireAt    DateTime
  User        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Table {
  id       Int       @id @default(autoincrement())
  name     String
  capacity Int
  type     TableType @default(RECTANGULAR)
  x        Float?
  y        Float?
  width    Float     @default(60)
  height   Float     @default(60)
  rotation Float     @default(0)
  tenantId String
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings Booking[] @relation("BookingTables")
  linksA   TableLink[] @relation("LinkA")
  linksB   TableLink[] @relation("LinkB")

  @@unique([tenantId, name])
}

// Per-tenant settings (one row per restaurant).
model RestaurantSettings {
  id                Int      @id @default(autoincrement())
  tenantId          String   @unique
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  avgTicket         Float    @default(55)
  floorPlanImageUrl String?
  /** Minutes after startTime before an open booking counts as late. */
  lateGraceMinutes  Int      @default(15)
  /** Auto-cancel open bookings past the late threshold. */
  autoCancelLate    Boolean  @default(true)
  /** Minutes a table is expected to turn (overtime detection). */
  tableTurnoverMinutes Int   @default(105)
  /** Require a card hold for parties at or above the size threshold. */
  depositEnabled    Boolean  @default(false)
  depositMinSize    Int      @default(6)
  updatedAt         DateTime @updatedAt
}

// Undirected adjacency edge between two tables (stored canonically aId < bId).
// Edited manually in the floor-plan editor; drives auto-assignment grouping.
model TableLink {
  aId Int
  bId Int
  a   Table @relation("LinkA", fields: [aId], references: [id], onDelete: Cascade)
  b   Table @relation("LinkB", fields: [bId], references: [id], onDelete: Cascade)

  @@id([aId, bId])
}

model Booking {
  id        String        @id @default(uuid())
  size      Int
  startTime DateTime
  endTime   DateTime
  status    BookingStatus @default(CONFIRMED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  language  String
  email     String?
  name      String
  phone     String?
  lowTable  Boolean       @default(false)
  /** Who cancelled: 'HOST' (manual) or 'AUTO' (no-show sweep). Null = never cancelled. */
  cancelledBy String?
  /** Staff tags: VIP, ALLERGY, BIRTHDAY, STROLLER. Shown on host cards. */
  tags String[] @default([])
  /** Guest confirmed (host toggle). Drives the confirmation icon. */
  guestConfirmed Boolean @default(false)
  /** Seated at (set on check-in). Drives overtime detection. */
  seatedAt DateTime?
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tables    Table[]       @relation("BookingTables")
}

enum TableType {
  RECTANGULAR
  OCTAGONAL
  CAPSULE
  ROUND
  SQUARE
  BAR
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}
