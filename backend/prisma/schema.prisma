generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                 String    @id @default(uuid())
  name               String
  slug               String    @unique
  trialEndsAt        DateTime
  onboardingComplete Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  users              User[]
  bookings           Booking[]
  tables             Table[]
  settings           RestaurantSettings?
}

enum Role {
  OWNER
  STAFF
}

model User {
  id            String         @id @unique @default(uuid())
  email         String         @unique
  password      String
  emailVerified DateTime?
  role          Role           @default(OWNER)
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id          String   @id @unique @default(uuid())
  hashedToken String   @unique
  userId      String
  revoked     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  expireAt    DateTime
  User        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Table {
  id       Int       @id @default(autoincrement())
  name     String
  capacity Int
  type     TableType @default(RECTANGULAR)
  x        Float?
  y        Float?
  width    Float     @default(60)
  height   Float     @default(60)
  rotation Float     @default(0)
  tenantId String
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings Booking[] @relation("BookingTables")
  linksA   TableLink[] @relation("LinkA")
  linksB   TableLink[] @relation("LinkB")

  @@unique([tenantId, name])
}

// Per-tenant settings (one row per restaurant).
model RestaurantSettings {
  id                Int      @id @default(autoincrement())
  tenantId          String   @unique
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  avgTicket         Float    @default(55)
  /** Optional per-service tickets; null = fall back to avgTicket. */
  avgTicketLunch    Float?
  avgTicketDinner   Float?
  floorPlanImageUrl String?
  /** Minutes after startTime before an open booking counts as late. */
  lateGraceMinutes  Int      @default(15)
  /** Auto-cancel open bookings past the late threshold. */
  autoCancelLate    Boolean  @default(true)
  /** Minutes a table is expected to turn (overtime detection). */
  tableTurnoverMinutes Int   @default(105)
  /** Require a card hold for parties at or above the size threshold. */
  depositEnabled    Boolean  @default(false)
  depositMinSize    Int      @default(6)
  /** Months of booking history kept before PII anonymization (GDPR). */
  retentionMonths   Int      @default(13)
  /** Fixed deposit hold per booking in euros (Stripe, manual capture). */
  depositAmount     Float    @default(20)
  /** Stripe Connect Express account of the restaurant (direct charges). */
  stripeAccountId   String?
  /** True once the restaurant finished Stripe onboarding (charges enabled). */
  stripeOnboarded   Boolean  @default(false)
  /**
   * Weekly opening schedule driving the public booking widget.
   * JSON: { "0": [{open:"12:00",close:"14:00"},{open:"19:00",close:"23:00"}], ... }
   * Keys are dayjs .day() (0=Sunday..6=Saturday); missing/empty day = closed.
   * Null = legacy default (16:00-22:00 every day). Max 2 ranges per day.
   */
  openHours         Json?
  updatedAt         DateTime @updatedAt
}

// Undirected adjacency edge between two tables (stored canonically aId < bId).
// Edited manually in the floor-plan editor; drives auto-assignment grouping.
model TableLink {
  aId Int
  bId Int
  a   Table @relation("LinkA", fields: [aId], references: [id], onDelete: Cascade)
  b   Table @relation("LinkB", fields: [bId], references: [id], onDelete: Cascade)

  @@id([aId, bId])
}

model Booking {
  id        String        @id @default(uuid())
  size      Int
  startTime DateTime
  endTime   DateTime
  status    BookingStatus @default(CONFIRMED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  language  String
  email     String?
  name      String
  phone     String?
  lowTable  Boolean       @default(false)
  /** Who cancelled: 'HOST' (manual) or 'AUTO' (no-show sweep). Null = never cancelled. */
  cancelledBy String?
  /** Staff tags: VIP, ALLERGY, BIRTHDAY, STROLLER. Shown on host cards. */
  tags String[] @default([])
  /** Free-text allergy detail (when ALLERGY tag set). Blank = none. */
  allergyNote String?
  /** Birth date (when BIRTHDAY tag set). Blank = none; age is derived. */
  birthdayDate DateTime?
  /** Free-text VIP note (when VIP tag set). Blank = none. */
  vipNote String?
  /** Origin: staff-entered on the spot (walk-in / phone at counter) vs reservation. */
  source BookingSource @default(RESERVATION)
  /** Meal finished at (host "repas terminé" action). Null = still seated / unknown. */
  leftAt DateTime?
  /** Soft-delete (GDPR erasure): excluded from every query, PII wiped. */
  deletedAt DateTime?
  /**
   * Fail-safe authorization-hold state machine (Stripe Connect, manual capture).
   * NONE → PENDING (hold opened) → HELD (funds authorized, 7-day Stripe clock
   * running) → RELEASED (guest arrived / timely cancel, hold cancelled) |
   * CAPTURED (explicit staff "Mark No-Show & Charge" only) |
   * EXPIRED (Stripe native 7-day expiry — NO code path writes this except the
   * Connect webhook on payment_intent.canceled with reason=expired) |
   * FAILED (checkout expired / card declined).
   * Terminal states (RELEASED, CAPTURED, EXPIRED, FAILED) never transition.
   * There is deliberately NO auto-capture path.
   */
  depositStatus DepositStatus @default(NONE)
  depositAmountCents Int?
  /** Native expiry of the uncaptured authorization (Stripe ~7 days). Informational only. */
  depositExpiresAt DateTime?
  stripePaymentIntentId String?
  stripeCheckoutSessionId String?
  /** Guest confirmed (host toggle). Drives the confirmation icon. */
  guestConfirmed Boolean @default(false)
  /** Seated at (set on check-in). Drives overtime detection. */
  seatedAt DateTime?
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tables    Table[]       @relation("BookingTables")

  @@index([tenantId, depositStatus, startTime])
  @@index([stripePaymentIntentId])
}

/**
 * Connect webhook idempotency ledger (single platform webhook).
 * Stripe may redeliver the same event id many times; the handler inserts
 * here first and returns 200 immediately on conflict (unique eventId).
 */
model StripeWebhookEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique
  /** Connect account from event.account (null = platform event). */
  stripeAccountId String?
  type        String
  bookingId   String?
  /** What the handler did: APPLIED | DUPLICATE | DROPPED_MISMATCH | IGNORED. */
  outcome     String
  createdAt   DateTime @default(now())

  @@index([stripeAccountId])
}

/** Authorization-hold lifecycle. EXPIRED is written ONLY by the Connect webhook. */
enum DepositStatus {
  NONE
  PENDING
  HELD
  CAPTURED
  RELEASED
  EXPIRED
  FAILED
}

enum TableType {
  RECTANGULAR
  OCTAGONAL
  CAPSULE
  ROUND
  SQUARE
  BAR
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum BookingSource {
  RESERVATION
  WALKIN
}
