# API Configuration
# Backend API base URL
VITE_API_URL=http://localhost:3000/api

# WebSocket URL
# Socket.IO connection URL
VITE_SOCKET_URL=http://localhost:3000

# Cloudflare Turnstile (Bot Protection)
# Public site key of the managed widget. Also set it as VITE_TURNSTILE_SITE_KEY
# in the Vercel dashboard so production builds use it.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAFJCu_xkH8gypxu4

# Application Settings
VITE_APP_NAME=MBC Reservation
VITE_DEFAULT_LANGUAGE=en

# Default restaurant slug for the legacy /book path (redirects to /b/:slug)
VITE_TENANT_SLUG=mbc
